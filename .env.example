VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-side only. Load it into Supabase Edge Functions with: npm run ai:secret
GEMINI_API_KEY=your-gemini-api-key

# Optional future backend/OAuth credentials. Do not expose these with VITE_.
LICHESS_CLIENT_ID=your-public-pkce-client-id
CHESSCOM_CLIENT_ID=provided-by-chesscom
CHESSCOM_CLIENT_SECRET=provided-by-chesscom
